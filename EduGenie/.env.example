# Required for Gemini-powered features
GEMINI_API_KEY=your_gemini_api_key_here
# Current Gemini model used by default. Change without editing Python code.
GEMINI_MODEL=gemini-3.5-flash

# "gemini" is the recommended lightweight/default path.
# "local" tries LaMini-Flan-T5-783M first and falls back to Gemini if local inference fails.
EXPLANATION_PROVIDER=gemini
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

APP_NAME=EduGenie
CORS_ORIGINS=*
MAX_INPUT_CHARS=20000
DEBUG=false
